{
  "name": "ideaforge",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bash -c 'cd /Users/manish/Documents/dev/projects/Superai && source .venv/bin/activate && PYTHONPATH=. uvicorn orchestrator.main:app --reload --host 0.0.0.0 --port 8000'",
    "start": "bash scripts/start-all.sh",
    "stop": "bash scripts/stop-all.sh",
    "build:web": "bun --cwd apps/web build",
    "lint:web": "bun --cwd apps/web lint",
    "deploy:web": "bash scripts/deploy-web.sh"
  }
}
