# Copy to .env and fill in values:
#   cp .env.example .env
#
# NEVER commit .env — it is gitignored.

# ── AWS (hackathon sandbox — get at kickoff) ──────────────────────
# Session tokens expire every few hours — re-run: aws sso login (or refresh hackathon creds)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
CDK_DEFAULT_ACCOUNT=
# Set true to skip AWS on every build (no error) when creds unavailable:
# AWS_SKIP_INFRA=true

# ── Vercel (hackathon credits) ───────────────────────────────────
# Deploy token — create at https://vercel.com/account/tokens (not the AI Gateway vck key)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_SCOPE=
ORCHESTRATOR_PUBLIC_URL=
V0_AUTO_DEPLOY=true
V0_API_KEY=
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh

# ── Exa (hackathon credits) ──────────────────────────────────────
EXA_API_KEY=
EXA_TEAM_ID=

# ── Stripe (hackathon credits — use test keys for dev) ───────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ── LLM providers ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_FAST=anthropic/claude-haiku-4.5
LLM_MODEL_STRATEGY=anthropic/claude-opus-4.8
LLM_MODEL_BUILDER=openai/gpt-5.5
LLM_PREFER_OPENAI_DIRECT=false
FAST_MODE=false
# UI builder: v0 (full Next.js app) | aura (single-page fallback only) | auto
# Internal config/aura_portfolio.json supplies visual direction to v0 prompts.
# Set AURA_REMIX_FIRST=true only to fetch live templates from aura.build as fallback.
UI_BUILDER=v0

# Optional aura.build Supabase overrides (defaults work for public templates)
# AURA_SUPABASE_URL=https://hoirqrkdgbmvpwutwuwj.supabase.co
# AURA_SUPABASE_ANON_KEY=

# Voice input — Whisper is default (reliable). Set true to try browser speech first.
# NEXT_PUBLIC_VOICE_USE_BROWSER=false
LOG_LEVEL=INFO
LOG_FILE=
SESSION_DB_PATH=

# ── Optional extras ────────────────────────────────────────────────
GITHUB_TOKEN=
DIFY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ideaforge

# ── App config ───────────────────────────────────────────────────
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
APP_ENV=development
WEB_ORIGIN=https://idea-forge-eta-six.vercel.app
